{
  "name": "@aaarc/handfree-ssh-mcp",
  "version": "1.0.19",
  "description": "Handfree SSH MCP Server - A hands-free SSH automation tool via MCP protocol",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "handfree-ssh-mcp": "build/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ironboxplus/handfree-ssh-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Ironboxplus/handfree-ssh-mcp/issues"
  },
  "homepage": "https://github.com/Ironboxplus/handfree-ssh-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run build && node --test build/tests/config.test.js build/tests/command-validation.test.js build/tests/tool-error.test.js build/tests/tools.test.js build/tests/output-collector.test.js build/tests/output-log-writer.test.js build/tests/recent-fixes.test.js build/tests/sftp-stall-timeout.test.js build/tests/keepalive-channel-open.test.js build/tests/status-collector.test.js build/tests/transfer-real.test.js build/tests/batch-upload-real.test.js build/tests/preflight.test.js build/tests/ssh-lab.test.js build/tests/contracts.test.js build/tests/characterization-legacy-tools.test.js build/tests/validate-contracts.test.js",
    "preflight": "node scripts/preflight.mjs --require A",
    "test:package": "node scripts/test-package.mjs",
    "test:acceptance:ssh": "node scripts/ssh-lab.mjs test ssh",
    "validate:contracts": "npm run build && node scripts/validate-contracts.mjs",
    "test:status": "npm run build && node --test build/tests/status-collector.test.js",
    "smoke:list-servers": "npm run build && node -- scripts/smoke-list-servers.js",
    "test:config": "npm run build && node --test build/tests/config.test.js",
    "test:cmd": "npm run build && node --test build/tests/command-validation.test.js",
    "test:tools": "npm run build && node --test build/tests/tools.test.js",
    "test:transfer:real": "npm run build && node --test build/tests/transfer-real.test.js",
    "test:coverage:transfer": "npm run build && node --experimental-test-coverage --test-coverage-include=build/services/ssh-connection-manager.js --test-coverage-include=build/tools/transfer.js --test-coverage-lines=45 --test-coverage-branches=54 --test-coverage-functions=60 --test build/tests/transfer-real.test.js",
    "test:integration": "npm run build && node build/tests/integration.test.js",
    "test:all": "npm run test && npm run test:integration",
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ssh",
    "mcp",
    "server",
    "cli"
  ],
  "author": "Junki",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.5",
    "js-yaml": "^4.1.0",
    "socks": "^2.8.6",
    "ssh2": "^1.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/ssh2": "^1.15.5",
    "typescript": "^5.8.2",
    "zod-to-json-schema": "^3.24.1"
  },
  "files": [
    "build/config/**/*",
    "build/connection/**/*",
    "build/core/**/*",
    "build/models/**/*",
    "build/services/**/*",
    "build/tools/**/*",
    "build/utils/**/*",
    "build/index.js"
  ]
}
